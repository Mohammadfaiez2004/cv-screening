    {
      "parameters": {
        "jsCode": "const applicant = $('نموذج التقديم').first().json;\nconst cvJson = $('cv استخراج النص من').first().json;\nconst cvText = cvJson.text || cvJson.data || JSON.stringify(cvJson);\nconst jobTitle = String(applicant['الوظيفة المتقدم لها'] || '').trim();\nconst jobs = $input.all();\nconst matched = jobs.find(item => {\n  const row = item.json;\n  const key = Object.keys(row).find(k => k.trim() === 'اسم الوظيفة');\n  if (!key) return false;\n  return String(row[key] || '').trim() === jobTitle;\n});\nlet criteria = {};\nif (matched) {\n  for (const [k, v] of Object.entries(matched.json)) {\n    criteria[k.trim()] = v;\n  }\n}\nreturn [{ json: {\n  applicantName: applicant['الاسم الكامل'],\n  applicantEmail: applicant['البريد الإلكتروني'],\n  applicantPhone: applicant['رقم الهاتف'],\n  statedYearsExperience: applicant['سنوات الخبرة'],\n  jobTitle,\n  cvText,\n  criteria,\n  cvLink: $('تسجيل الطلب في السجل').first().json['رابط CV'] || ''\n} }];"
      },
