      "parameters": {
        "jsCode": "const applicant = $('نموذج التقديم').first().json;\nconst jobTitle = applicant['الوظيفة المتقدم لها'];\nconst today = $now;\nconst oneMonthAgo = today.minus({ days: 30 });\nconst matchingEmailRows = $input.all(); // الصفوف مفلترة بالبريد من Google Sheets مباشرة\n\nconst isDuplicate = matchingEmailRows.some(item => {\n  const row = item.json;\n  if (row['الوظيفة المتقدم لها'] !== jobTitle) return false;\n  const rowDateStr = row['تاريخ التقديم'];\n  if (!rowDateStr) return false;\n  const rowDate = DateTime.fromFormat(String(rowDateStr), 'yyyy-MM-dd');\n  if (!rowDate.isValid) return false;\n  return rowDate >= oneMonthAgo;\n});\n\nreturn [{\n  json: {\n    ...applicant,\n    isDuplicate,\n    ['تاريخ التقديم']: today.toFormat('yyyy-MM-dd')\n  },\n  binary: $('نموذج التقديم').first().binary\n}];"
      },
