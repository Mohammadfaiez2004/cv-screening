    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nlet raw;\nif (item.content) {\n  if (typeof item.content === 'string') {\n    raw = item.content;\n  } else if (item.content.parts && Array.isArray(item.content.parts)) {\n    raw = item.content.parts.map(p => p.text || '').join('');\n  } else {\n    raw = JSON.stringify(item.content);\n  }\n} else {\n  raw = item.text ?? (item.message && item.message.content) ?? item.output ?? JSON.stringify(item);\n}\nconst cleaned = String(raw).replace(/```json|```/g, '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { decision: 'مراجعة', reasoning: 'تعذر تحليل استجابة AI تلقائياً - تحتاج مراجعة يدوية', raw: cleaned };\n}\nif (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {\n  parsed = { decision: 'مراجعة', reasoning: 'تعذر تحليل استجابة AI تلقائياً - تحتاج مراجعة يدوية' };\n}\n\n// أي قرار غير معروف يذهب إلى المراجعة البشرية وليس إلى الرفض\nconst ALLOWED_DECISIONS = ['مقبول', 'مراجعة', 'مرفوض'];\nlet decision = String(parsed.decision ?? '').trim();\nlet reasoning = parsed.reasoning || '';\nif (!ALLOWED_DECISIONS.includes(decision)) {\n  reasoning = `[قرار غير معروف من AI: \"${decision || 'فارغ'}\" - تحتاج مراجعة بشرية] ${reasoning}`.trim();\n  decision = 'مراجعة';\n}\n\nconst base = $('اختيار معايير الوظيفة المطابقة').first().json;\n\nfunction normalizeLinks(value) {\n  if (!value) return '';\n  const str = Array.isArray(value) ? value.join(',') : String(value);\n  const parts = str.split(/[,،]/).map(s => s.trim()).filter(Boolean);\n  if (parts.length === 0) return '';\n  const normalized = parts.map(url => /^https?:\\/\\//i.test(url) ? url : 'https://' + url);\n  return normalized.join('\\n');\n}\n\nfunction normalizeSingleLink(value) {\n  if (!value) return '';\n  const url = String(value).trim();\n  if (!url) return '';\n  return /^https?:\\/\\//i.test(url) ? url : 'https://' + url;\n}\n\nreturn [{ json: {\n  ['الاسم']: parsed.name || base.applicantName,\n  ['البريد الإلكتروني']: parsed.email || base.applicantEmail,\n  ['رقم الهاتف']: (base.applicantPhone || parsed.phone) ? \"'\" + String(base.applicantPhone || parsed.phone) : '',\n  ['الوظيفة المتقدم لها']: base.jobTitle,\n  ['سنوات الخبرة']: parsed.years_experience || base.statedYearsExperience || '',\n  ['المهارات']: parsed.skills || '',\n  ['المؤهل العلمي']: parsed.education || '',\n  ['درجة المطابقة']: parsed.match_score || '',\n  ['الحالة']: decision,\n  ['سبب القرار']: reasoning,\n  ['GitHub']: normalizeSingleLink(parsed.github),\n  ['LinkedIn']: normalizeSingleLink(parsed.linkedin),\n  ['روابط أخرى']: normalizeLinks(parsed.other_links),\n  ['رابط CV']: base.cvLink || '',\n  ['تاريخ التقديم']: $now.toFormat('yyyy-MM-dd')\n} }];"
      },
