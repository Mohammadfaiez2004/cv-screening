    {
      "parameters": {
        "jsCode": "const today = $now.toFormat('yyyy-MM-dd');\nconst accepted = $('قراءة المقبولين').all().filter(item => item.json['تاريخ التقديم'] === today);\nconst review = $('قراءة قيد المراجعة').all().filter(item => item.json['تاريخ التقديم'] === today);\n\n// علامات اتجاه النص: تمنع تداخل الأرقام والكلمات الإنجليزية مع النص العربي\nconst RLM = '\\u200F';\nconst iso = v => '\\u2066' + v + '\\u2069';\n\nconst PER_MSG = 10;   // عدد المرشحين في الرسالة الواحدة\nconst MAX = 3800;     // حد أمان تحت حد تيليغرام (4096)\n\nfunction formatLine(item) {\n  const j = item.json;\n  const lines = [\n    `${RLM}• ${j['الاسم'] || ''}`,\n    `${RLM}   الوظيفة: ${j['الوظيفة المتقدم لها'] || ''}`,\n    `${RLM}   الهاتف: ${iso(j['رقم الهاتف'] || '')}`,\n    `${RLM}   درجة المطابقة: ${iso((j['درجة المطابقة'] || '') + '%')}`\n  ];\n  if (j['GitHub']) lines.push(`${RLM}   GitHub: ${iso(j['GitHub'])}`);\n  if (j['LinkedIn']) lines.push(`${RLM}   LinkedIn: ${iso(j['LinkedIn'])}`);\n  return lines.join('\\n');\n}\n\n// تقسيم القائمة: 10 مرشحين كحد أقصى، وبما لا يتجاوز حد الأحرف\nfunction pack(entries) {\n  const groups = [];\n  let cur = [], len = 0;\n  for (const e of entries) {\n    if (cur.length >= PER_MSG || (cur.length && len + e.length + 2 > MAX)) {\n      groups.push(cur); cur = []; len = 0;\n    }\n    cur.push(e); len += e.length + 2;\n  }\n  if (cur.length) groups.push(cur);\n  return groups;\n}\n\nconst header = `📋 ملخص اليوم — ${today}\\n✅ مقبولون: ${accepted.length}  |  🔍 مراجعة: ${review.length}`;\nconst messages = [];\n\nfunction addSection(title, items) {\n  if (!items.length) return;\n  const groups = pack(items.map(formatLine));\n  groups.forEach((g, i) => {\n    const part = groups.length > 1 ? ` (${i + 1}/${groups.length})` : '';\n    messages.push(`${header}\\n\\n${title}${part}\\n\\n` + g.join('\\n\\n'));\n  });\n}\n\naddSection('✅ مقبولون', accepted);\naddSection('🔍 يحتاجون مراجعة', review);\n\nif (!messages.length) messages.push(`${header}\\n\\nلا يوجد مقبولون ولا حالات مراجعة اليوم`);\n\n// كل عنصر يُرسَل كرسالة تيليغرام مستقلة\nreturn messages.map(message => ({ json: { message } }));"
      },
